;; kotoba-lang/host — browser game host surface (ADR-2607102200 addendum 8):
;;   kami.host  — WASM/ECS import object for compiled games
;;   kami.input — keyboard/gamepad → axes
;;   kami.ui    — DOM HUD widgets
;;   kami.audio — Web Audio synth bank
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        io.github.kotoba-lang/physics {:git/url "https://github.com/kotoba-lang/physics.git"
         :git/sha "5fbd5979dfe6a0be92c43c439e41878b9ef5f9c8"}
        ;; kotoba.physics.contract/step + physics-2d.backend/backend for the
        ;; rigid-body-2d ECS system (kami.host/step-rigid-bodies!) — routes
        ;; through the shared realtime physics contract instead of a bespoke
        ;; ad-hoc physics loop (kami-engine physics-2d integration).
        io.github.kotoba-lang/physics-2d {:git/url "https://github.com/kotoba-lang/physics-2d.git"
         :git/sha "b6cd07ef47b5952a5ba74c21e52626daaeb4777f"}
        io.github.kotoba-lang/kami-engine-sdk {:git/url "https://github.com/kotoba-lang/kami-engine-sdk.git"
         :git/sha "03255f3dec8611a060edce79b321872c7945a68a"}}
 :override-deps {io.github.kotoba-lang/physics {:git/url "https://github.com/kotoba-lang/physics.git"
         :git/sha "5fbd5979dfe6a0be92c43c439e41878b9ef5f9c8"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
